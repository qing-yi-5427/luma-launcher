<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Luma.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>Luma</AssemblyName>
    <RootNamespace>LumaLauncher</RootNamespace>
    <Version>0.2.0</Version>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <DebugType>embedded</DebugType>
    <SatelliteResourceLanguages>zh-Hans;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Tests\**\*.cs" />
    <Compile Remove="Tools\**\*.cs" />
    <Resource Include="Assets\Luma.ico" />
    <None Remove="THIRD_PARTY_NOTICES.md" />
    <EmbeddedResource Include="THIRD_PARTY_NOTICES.md" LogicalName="Luma.ThirdPartyNotices.md" />
    <None Include="dll\Everything64.dll"
          Link="Everything64.dll"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
