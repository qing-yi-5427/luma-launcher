<Window x:Class="LumaLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Luma" Icon="/Assets/Luma.ico" Width="700" Height="94"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="False"
        Background="{DynamicResource WindowBrush}" ShowInTaskbar="False" Topmost="True"
        FontFamily="Segoe UI Variable Text, Segoe UI" Foreground="{DynamicResource TextBrush}"
        Deactivated="Window_Deactivated" PreviewKeyDown="Window_PreviewKeyDown"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" CornerRadius="14" GlassFrameThickness="0" ResizeBorderThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="FilterButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="MinWidth" Value="42"/>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="AutomationProperties.Name" Value="{Binding Title}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemChrome" Background="Transparent" CornerRadius="9" SnapsToDevicePixels="True">
                            <Grid>
                                <Border x:Name="AccentRail" Width="3" Height="24" CornerRadius="2"
                                        Background="{DynamicResource AccentBrush}" HorizontalAlignment="Left" Opacity="0"/>
                                <ContentPresenter Margin="12,0,10,0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource PanelHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource PanelSelectedBrush}"/>
                                <Setter TargetName="AccentRail" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="WindowChrome" Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource StrokeBrush}"
            BorderThickness="1" CornerRadius="14" ClipToBounds="True">
        <Border.RenderTransform>
            <TranslateTransform x:Name="WindowTranslate"/>
        </Border.RenderTransform>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="92"/>
                <RowDefinition x:Name="ResultsRow" Height="0"/>
                <RowDefinition x:Name="FooterRow" Height="0"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="22,0,18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid Width="28" Height="28" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <Ellipse Fill="{DynamicResource AccentSoftBrush}"/>
                    <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15"
                               Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>

                <Grid Grid.Column="1">
                    <TextBlock x:Name="SearchHint" Text="搜索应用、文件，输入 = 计算，? 搜网页"
                               Foreground="{DynamicResource FaintTextBrush}" FontSize="20" VerticalAlignment="Center"
                               IsHitTestVisible="False"/>
                    <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0"
                             Foreground="{DynamicResource TextBrush}" CaretBrush="{DynamicResource AccentBrush}"
                             FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="21" FontWeight="Light"
                             VerticalContentAlignment="Center" Padding="0,2" Cursor="IBeam" TextChanged="SearchBox_TextChanged"
                             AutomationProperties.Name="Luma 搜索"/>
                </Grid>

                <Border Grid.Column="2" CornerRadius="6" Padding="9,5" VerticalAlignment="Center"
                        Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="5" Height="5" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBlock x:Name="HotkeyText" Text="ALT  SPACE" FontFamily="Bahnschrift SemiCondensed, Segoe UI"
                                   FontSize="10" Foreground="{DynamicResource MutedTextBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid x:Name="ResultsHost" Grid.Row="1" Margin="12,0" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="36"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="8,2,0,4">
                    <Button x:Name="AllFilterButton" Content="全部" Tag="All" Style="{StaticResource FilterButton}" Click="Filter_Click"/>
                    <Button x:Name="AppFilterButton" Content="应用" Tag="Application" Style="{StaticResource FilterButton}" Click="Filter_Click"/>
                    <Button x:Name="FileFilterButton" Content="文件" Tag="File" Style="{StaticResource FilterButton}" Click="Filter_Click"/>
                    <Button x:Name="FolderFilterButton" Content="文件夹" Tag="Folder" Style="{StaticResource FilterButton}" Click="Filter_Click"/>
                </StackPanel>
                <TextBlock x:Name="EmptyText" Text="没有找到匹配项" Foreground="{DynamicResource MutedTextBrush}"
                           Grid.Row="1" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <ListBox x:Name="ResultsList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                         SelectionChanged="ResultsList_SelectionChanged" MouseDoubleClick="ResultsList_MouseDoubleClick"
                         PreviewMouseRightButtonDown="ResultsList_PreviewMouseRightButtonDown">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="48">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid Width="30" Height="30" VerticalAlignment="Center">
                                    <Border CornerRadius="7" Background="{DynamicResource PanelHoverBrush}"/>
                                    <TextBlock Text="{Binding FallbackGlyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="15" Foreground="{DynamicResource MutedTextBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Image Source="{Binding Icon}" Width="22" Height="22" Stretch="Uniform"/>
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="2,0,12,0">
                                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Subtitle}" FontSize="10.5" Margin="0,2,0,0"
                                               Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding FavoriteGlyph}" Foreground="{DynamicResource AccentBrush}"
                                               FontSize="10" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource StrokeBrush}"
                                            BorderThickness="1" CornerRadius="5" Padding="7,3">
                                        <TextBlock Text="{Binding SourceLabel}" FontFamily="Bahnschrift SemiCondensed, Segoe UI"
                                                   Foreground="{DynamicResource FaintTextBrush}" FontSize="9"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <Border x:Name="Footer" Grid.Row="2" Visibility="Collapsed" BorderBrush="{DynamicResource StrokeBrush}"
                    BorderThickness="0,1,0,0" Background="{DynamicResource PanelBrush}">
                <Grid Margin="18,0">
                    <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="10.5"
                               Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,330,0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="↵ 打开" FontSize="10" Foreground="{DynamicResource FaintTextBrush}" Margin="0,0,15,0"/>
                        <TextBlock Text="⌃↵ 定位" FontSize="10" Foreground="{DynamicResource FaintTextBrush}" Margin="0,0,15,0"/>
                        <TextBlock x:Name="QuickSwitchHint" Text="⌃G 快速切换" FontSize="10"
                                   Foreground="{DynamicResource AccentBrush}" Margin="0,0,15,0" Visibility="Collapsed"/>
                        <Button x:Name="MoreButton" Content="更多" Style="{StaticResource FilterButton}"
                                Margin="0" Click="MoreButton_Click" Visibility="Collapsed"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
