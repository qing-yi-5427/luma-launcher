<Window x:Class="LumaLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:LumaLauncher.Services"
        services:SearchHighlight.Query="{Binding Text, ElementName=SearchBox}"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Luma" Icon="/Luma;component/Assets/Luma.ico" Width="660" Height="82"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" Topmost="True"
        FontFamily="Segoe UI Variable Text, Microsoft YaHei UI, Segoe UI" Foreground="{DynamicResource TextBrush}"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Deactivated="Window_Deactivated" PreviewKeyDown="Window_PreviewKeyDown"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <Style x:Key="GhostFooterButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0,0,0,0"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style x:Key="DetailActionButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
            <Setter Property="Padding" Value="11,7"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="MinWidth" Value="72"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="HeaderActionButton" TargetType="Button">
            <Setter Property="Width" Value="60"/>
            <Setter Property="Height" Value="60"/>
            <Setter Property="Margin" Value="0,0,7,0"/>
            <Setter Property="Background" Value="{DynamicResource LauncherMaterialBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusStyle}"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="Button">
                    <Border x:Name="Circle" CornerRadius="30" Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Circle" Property="Background" Value="{DynamicResource PanelHoverBrush}"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Circle" Property="Opacity" Value="0.64"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SegmentButton" TargetType="Button" BasedOn="{StaticResource ChipButton}">
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="13,5"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Segment" CornerRadius="8" Margin="2" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Segment" Property="Opacity" Value="0.82"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Segment" Property="Opacity" Value="0.65"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HistoryItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Chrome" Background="Transparent" CornerRadius="{DynamicResource RadiusSm}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource PanelHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SurfaceElevatedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="AutomationProperties.Name" Value="{Binding Title}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemChrome" Background="Transparent" CornerRadius="9"
                                SnapsToDevicePixels="True" Margin="8,1" BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter Margin="10,0,10,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource PanelHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource SpotlightSelectionBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ItemChrome" Property="BorderBrush" Value="{DynamicResource SpotlightSelectionTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="LauncherRoot" Background="Transparent" SizeChanged="LauncherRoot_SizeChanged">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="WindowTranslate"/>
        </Grid.RenderTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="82"/>
                <RowDefinition x:Name="ResultsRow" Height="0"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition x:Name="FooterRow" Height="0"/>
            </Grid.RowDefinitions>

            <!-- Search row -->
            <Grid Grid.Row="0" Margin="15,9,7,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="66"/>
                </Grid.ColumnDefinitions>
                <Grid x:Name="SearchCapsuleHost" Grid.Column="0" Margin="0,0,8,0">
                    <Border CornerRadius="32" Background="{DynamicResource LauncherMaterialBrush}">
                        <Border.Effect><DropShadowEffect Color="#99000000" BlurRadius="15" ShadowDepth="3" Opacity="0.27"/></Border.Effect>
                    </Border>
                    <Border CornerRadius="32" Background="Transparent"
                            BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1">
                    <Grid Margin="21,0,15,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="25"
                                   Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center"/>
                        <Grid Grid.Column="1" Margin="0,0,5,0">
                            <TextBlock x:Name="SearchHint" Text="搜索"
                                       Foreground="{DynamicResource FaintTextBrush}" FontSize="27" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" IsHitTestVisible="False"/>
                            <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0"
                                     Foreground="{DynamicResource TextBrush}" CaretBrush="{DynamicResource AccentBrush}"
                                     FontFamily="Segoe UI Variable Display, Microsoft YaHei UI, Segoe UI" FontSize="27"
                                     VerticalContentAlignment="Center" Padding="0" Cursor="IBeam" TextChanged="SearchBox_TextChanged"
                                     AutomationProperties.Name="Luma 搜索"/>
                        </Grid>
                        <TextBlock x:Name="HotkeyText" Grid.Column="2" Text="ALT SPACE" FontSize="10"
                                   Foreground="{DynamicResource FaintTextBrush}" Opacity="0.6"
                                   HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10,0,3,6"
                                   MaxWidth="95" TextTrimming="CharacterEllipsis"
                                   IsHitTestVisible="False"/>
                    </Grid>
                    </Border>
                </Grid>
                <Button x:Name="HeaderMoreButton" Grid.Column="1" Content="&#xE10C;"
                        Style="{StaticResource HeaderActionButton}" ToolTip="更多操作" Click="HeaderMore_Click"/>
            </Grid>

            <Border x:Name="ResultsSurface" Grid.Row="1" Grid.RowSpan="3" Visibility="Collapsed"
                    Background="{DynamicResource LauncherMaterialBrush}" BorderBrush="{DynamicResource HairlineBrush}"
                    BorderThickness="1" CornerRadius="20" Margin="15,4,15,5">
                <Border.Effect><DropShadowEffect Color="#99000000" BlurRadius="20" ShadowDepth="7" Opacity="0.3"/></Border.Effect>
            </Border>

            <!-- Results -->
            <Grid x:Name="ResultsHost" Grid.Row="1" Margin="22,10,22,0" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Margin="15,2,15,7" LastChildFill="False">
                    <Button x:Name="SortButton" DockPanel.Dock="Right" Content="智能排序 ▾"
                            Style="{StaticResource GhostFooterButton}" Margin="4,0,0,0" VerticalAlignment="Top"
                            AutomationProperties.Name="结果排序" Click="SortButton_Click"
                            ToolTip="选择排序；名称、大小和修改时间由 Everything 全局召回。"/>
                    <Button x:Name="FilterMenuButton" DockPanel.Dock="Right" Content="筛选 ▾"
                            Style="{StaticResource GhostFooterButton}" Click="FilterMenu_Click"/>
                    <Button x:Name="AllFilterButton" Tag="All" Visibility="Collapsed" Click="Filter_Click"/>
                    <Button x:Name="FolderFilterButton" Tag="Folder" Visibility="Collapsed" Click="Filter_Click"/>
                    <TextBlock x:Name="ResultsHeadingText" Text="最佳匹配" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ResultCountText" FontSize="11" Margin="9,0,0,0"
                               Foreground="{DynamicResource FaintTextBrush}" VerticalAlignment="Center"/>
                </DockPanel>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="ResultsPaneColumn" Width="*"/>
                        <ColumnDefinition x:Name="DetailsDividerColumn" Width="0"/>
                        <ColumnDefinition x:Name="DetailsPaneColumn" Width="0"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Visibility="Collapsed" Margin="0,16" MinHeight="108">
                            <Border Width="40" Height="40" CornerRadius="12" Background="{DynamicResource SurfaceSubtleBrush}"
                                    HorizontalAlignment="Center" Margin="0,0,0,10">
                                <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons" FontSize="16"
                                           Foreground="{DynamicResource FaintTextBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="EmptyTitle" Text="没有找到匹配项" FontSize="14" FontWeight="Medium"
                                       Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="EmptyHint" Text="试试 Everything 语法，或清除类型过滤"
                                       FontSize="12" Margin="0,6,0,0"
                                       Foreground="{DynamicResource FaintTextBrush}" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <ListBox x:Name="ResultsList" Background="Transparent" BorderThickness="0" Margin="0,2,0,0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                                 SelectionChanged="ResultsList_SelectionChanged" MouseDoubleClick="ResultsList_MouseDoubleClick"
                                 PreviewMouseRightButtonDown="ResultsList_PreviewMouseRightButtonDown"
                                 AllowDrop="True" PreviewMouseMove="ResultsList_PreviewMouseMove">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Loaded="ResultItem_Loaded" DataContextChanged="ResultItem_DataContextChanged"
                                          Height="{Binding DataContext.ResultRowHeight, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=54}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="52"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="40" Height="40" VerticalAlignment="Center">
                                            <Border CornerRadius="10" Background="{Binding IconBackground}"/>
                                            <TextBlock Text="{Binding FallbackGlyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                       FontSize="19" Foreground="White"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Image Source="{Binding Icon}" Width="30" Height="30" Stretch="Uniform"/>
                                        </Grid>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="2,0,10,0">
                                            <TextBlock x:Name="ResultTitle" services:SearchHighlight.Text="{Binding Title}" services:SearchHighlight.Monochrome="True" FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock x:Name="ResultSubtitle" services:SearchHighlight.Text="{Binding Subtitle}" services:SearchHighlight.Monochrome="True" FontSize="12" Margin="0,2,0,0"
                                                       Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0">
                                            <TextBlock x:Name="FavoriteMarker" Text="{Binding FavoriteGlyph}" Foreground="{DynamicResource AccentBrush}"
                                                       FontSize="11.5" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <Border x:Name="SourceBadge" Background="{DynamicResource PanelBrush}"
                                                    CornerRadius="5" Padding="7,3" Opacity="0.55">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SourceLabel}" Value="APP">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding SourceLabel}" Value="FILE">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding SourceLabel}" Value="FOLDER">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding SourceLabel}" FontFamily="Bahnschrift SemiCondensed, Segoe UI"
                                                           Foreground="{DynamicResource FaintTextBrush}" FontSize="10.5"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                            <Setter TargetName="ResultTitle" Property="Foreground" Value="{DynamicResource SpotlightSelectionTextBrush}"/>
                                            <Setter TargetName="ResultSubtitle" Property="Foreground" Value="{DynamicResource SpotlightSelectionTextBrush}"/>
                                            <Setter TargetName="FavoriteMarker" Property="Foreground" Value="{DynamicResource SpotlightSelectionTextBrush}"/>
                                            <Setter TargetName="ResultTitle" Property="services:SearchHighlight.Selected" Value="True"/>
                                            <Setter TargetName="ResultSubtitle" Property="services:SearchHighlight.Selected" Value="True"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Border x:Name="HistoryPanel" Visibility="Collapsed" Margin="8,6,8,0"
                                Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource StrokeBrush}"
                                BorderThickness="1" CornerRadius="{DynamicResource RadiusMd}" Padding="12,10">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" LastChildFill="True">
                                    <Button DockPanel.Dock="Right" Content="清空" Style="{StaticResource GhostFooterButton}"
                                            Margin="6,0,0,0" Click="ClearHistoryPanel_Click"/>
                                    <Button DockPanel.Dock="Right" Content="关闭" Style="{StaticResource GhostFooterButton}"
                                            Click="HistoryClose_Click"/>
                                    <TextBlock Text="搜索历史 · Ctrl+H" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                </DockPanel>
                                <TextBlock x:Name="HistoryEmpty" Text="还没有搜索历史" Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="12" Visibility="Collapsed"/>
                                <ListBox x:Name="HistoryList" Background="Transparent" BorderThickness="0" MaxHeight="220"
                                         MouseDoubleClick="HistoryList_MouseDoubleClick"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         ItemContainerStyle="{StaticResource HistoryItemStyle}"/>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <Border x:Name="DetailsDivider" Grid.Column="1" Width="1" Margin="8,4"
                            Background="{DynamicResource StrokeBrush}" Visibility="Collapsed"/>

                    <!-- Details / preview (Phase 3) -->
                    <Border x:Name="DetailsPane" Grid.Column="2" Visibility="Collapsed" Margin="0,4,8,8"
                            Padding="22,20,18,18" Background="Transparent">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <StackPanel HorizontalAlignment="Center" Margin="0,10,0,12">
                                    <Grid Width="76" Height="76" HorizontalAlignment="Center">
                                        <Border CornerRadius="19" Background="{Binding SelectedItem.IconBackground, ElementName=ResultsList}"/>
                                        <TextBlock Text="{Binding SelectedItem.FallbackGlyph, ElementName=ResultsList}"
                                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="33"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Image Source="{Binding SelectedItem.Icon, ElementName=ResultsList}"
                                               Width="58" Height="58" Stretch="Uniform"/>
                                    </Grid>
                                    <TextBlock services:SearchHighlight.Text="{Binding SelectedItem.Title, ElementName=ResultsList}"
                                               services:SearchHighlight.Monochrome="True" FontSize="18" FontWeight="SemiBold"
                                               TextWrapping="Wrap" TextAlignment="Center" MaxWidth="270" Margin="0,12,0,0"
                                               Foreground="{DynamicResource TextBrush}"/>
                                    <TextBlock x:Name="DetailKindText" Margin="0,4,0,0" FontSize="12"
                                               Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center"/>
                                </StackPanel>

                                <Border x:Name="DetailPreviewHost" Margin="0,14,0,0" CornerRadius="{DynamicResource RadiusMd}"
                                        Background="{DynamicResource SurfaceSubtleBrush}" Padding="8"
                                        Visibility="Collapsed" MaxHeight="200">
                                    <Image x:Name="DetailPreviewImage" Stretch="Uniform" MaxHeight="184"
                                           HorizontalAlignment="Center"/>
                                </Border>

                                <Border x:Name="DetailSkeleton" Margin="0,14,0,0" Height="88"
                                        CornerRadius="{DynamicResource RadiusMd}"
                                        Background="{DynamicResource SurfaceSubtleBrush}"
                                        Visibility="Collapsed" Opacity="0.7"/>

                                <Grid Margin="0,20,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="大小" FontSize="11" Foreground="{DynamicResource FaintTextBrush}"/>
                                        <TextBlock x:Name="DetailSizeText" Margin="0,3,8,0" FontSize="12"
                                                   Foreground="{DynamicResource MutedTextBrush}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="修改时间" FontSize="11" Foreground="{DynamicResource FaintTextBrush}"/>
                                        <TextBlock x:Name="DetailModifiedText" Margin="0,3,0,0" FontSize="12"
                                                   Foreground="{DynamicResource MutedTextBrush}"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="位置" FontSize="11" Foreground="{DynamicResource FaintTextBrush}" Margin="0,14,0,4"/>
                                <TextBlock x:Name="DetailLocationText" FontSize="11.5" TextWrapping="Wrap"
                                           Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,10"/>

                                <TextBlock x:Name="DetailDescriptionText" FontSize="11.5" LineHeight="17"
                                           Foreground="{DynamicResource FaintTextBrush}" TextWrapping="Wrap"
                                           Margin="0,0,0,14"/>

                                <WrapPanel x:Name="DetailActionsPanel" Margin="0,10,0,0">
                                    <Button x:Name="DetailOpenButton" Content="打开" Style="{StaticResource AccentButton}"
                                            Click="DetailOpen_Click"/>
                                    <Button x:Name="DetailRevealButton" Content="定位" Style="{StaticResource DetailActionButton}"
                                            Click="DetailReveal_Click"/>
                                    <Button x:Name="DetailCopyButton" Content="复制" Style="{StaticResource DetailActionButton}"
                                            Click="DetailCopy_Click"/>
                                    <Button x:Name="DetailFavoriteButton" Content="收藏" Style="{StaticResource DetailActionButton}"
                                            Click="DetailFavorite_Click"/>
                                    <Button x:Name="DetailQuickSwitchButton" Content="切换" Style="{StaticResource DetailActionButton}"
                                            Click="DetailQuickSwitch_Click" Visibility="Collapsed"/>
                                    <Button x:Name="DetailAdminButton" Content="管理员" Style="{StaticResource DetailActionButton}"
                                            Click="DetailAdmin_Click" Visibility="Collapsed"/>
                                </WrapPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>

            <!-- Thin loading bar (Phase 5) -->
            <Grid Grid.Row="2" Height="2" x:Name="ProgressHost" Visibility="Collapsed"
                  Margin="17,0,17,0" ClipToBounds="True">
                <Border Background="{DynamicResource SurfaceSubtleBrush}" CornerRadius="1"/>
                <Border x:Name="ProgressPulse" Background="{DynamicResource AccentBrush}" CornerRadius="1"
                        HorizontalAlignment="Left" Width="80" Opacity="0.85">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="ProgressPulseTransform"/>
                    </Border.RenderTransform>
                </Border>
            </Grid>

            <!-- Footer -->
            <Border x:Name="Footer" Grid.Row="3" Visibility="Collapsed" BorderBrush="{DynamicResource StrokeBrush}"
                    BorderThickness="0,1,0,0" CornerRadius="0,0,19,19" Margin="16,0,16,5" Background="Transparent">
                <Grid Margin="18,0" Height="42">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusText" AutomationProperties.LiveSetting="Polite" VerticalAlignment="Center" FontSize="11.5"
                               Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"
                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="QuickSwitchHint" Text="" Visibility="Collapsed"/>
                        <Button x:Name="OpenFooterButton" Content="打开  ↵" Style="{StaticResource GhostFooterButton}"
                                Click="OpenFooter_Click"/>
                        <Button x:Name="ActionMenuButton" Content="操作  ···" Style="{StaticResource GhostFooterButton}"
                                Click="FooterActions_Click" Margin="5,0,0,0"/>
                        <Button x:Name="MoreButton" Content="查看全部" Style="{StaticResource GhostFooterButton}"
                                Click="MoreButton_Click" Visibility="Collapsed"/>
                        <Button x:Name="LoadMoreButton" Content="更多结果" Style="{StaticResource GhostFooterButton}"
                                Margin="4,0,0,0" Click="LoadMore_Click" Visibility="Collapsed"/>
                    </StackPanel>
        </Grid>
            </Border>

            <!-- Help / welcome overlay (F1). Window expands via OpenHelp(). -->
            <Border x:Name="HelpOverlay" Grid.Row="0" Grid.RowSpan="4" Visibility="Collapsed"
                    Background="{DynamicResource LauncherMaterialBrush}" CornerRadius="20" Margin="15,9,15,5"
                    MouseLeftButtonDown="HelpOverlay_Click">
                <Border Background="Transparent" CornerRadius="10"
                        Margin="24" Padding="26,20" MaxWidth="560"
                        VerticalAlignment="Center" HorizontalAlignment="Center"
                        BorderBrush="Transparent" BorderThickness="0">
                    <StackPanel>
                        <TextBlock x:Name="HelpTitleText" Text="快捷键" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,10"/>
                        <TextBlock FontSize="12.5" Foreground="{DynamicResource TextBrush}" LineHeight="21"
                                   TextWrapping="Wrap"
                                   Text="Alt+Space（可改）　显示 / 隐藏&#x0a;↑ ↓　选择结果&#x0a;Enter / Ctrl+Enter / Ctrl+Shift+Enter　打开 / 定位 / 管理员&#x0a;Tab　补全历史查询&#x0a;Ctrl+H　搜索历史&#x0a;Ctrl+G　切换文件对话框&#x0a;Ctrl+,　设置&#x0a;Ctrl+F12　游戏模式&#x0a;F1　开关本帮助&#x0a;Esc　关闭帮助 / 退出全结果 / 隐藏"/>
                        <TextBlock Text="= 计算　? 网页　win 窗口　clip 剪贴板" FontSize="11.5"
                                   Foreground="{DynamicResource MutedTextBrush}" Margin="0,12,0,0"/>
                        <TextBlock Text="点击任意处关闭" FontSize="11" Foreground="{DynamicResource FaintTextBrush}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </Border>
    </Grid>
</Window>
