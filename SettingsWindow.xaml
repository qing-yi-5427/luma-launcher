<Window x:Class="LumaLauncher.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Luma 设置" Icon="/Luma;component/Assets/Luma.ico" Width="740" Height="680" WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="NoResize" Topmost="True" AllowsTransparency="False" Background="Transparent"
        Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI Variable Text, Microsoft YaHei UI, Segoe UI"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" CornerRadius="0" GlassFrameThickness="-1" ResizeBorderThickness="0"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="SectionHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
        </Style>
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14"/>
        </Style>
        <Style x:Key="LumaComboBoxItemStyle" TargetType="{x:Type ComboBoxItem}">
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                        <Border x:Name="ItemBackground" Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBackground" Property="Background"
                                        Value="{DynamicResource PanelHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBackground" Property="Background"
                                        Value="{DynamicResource PanelSelectedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusStyle}"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource LumaComboBoxItemStyle}"/>
            <Setter Property="MaxDropDownHeight" Value="260"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid x:Name="Root">
                            <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7"/>

                            <ContentPresenter Margin="10,0,38,0" VerticalAlignment="Center"
                                              HorizontalAlignment="Left" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              RecognizesAccessKey="True"/>

                            <Path x:Name="Arrow" Width="8" Height="5" Margin="0,0,13,0"
                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Data="M 0 0 L 4 4 L 8 0" Stroke="{DynamicResource MutedTextBrush}"
                                  StrokeThickness="1.4" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  IsHitTestVisible="False"/>

                            <ToggleButton Focusable="False" ClickMode="Press" Background="Transparent"
                                          BorderThickness="0"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   PopupAnimation="Fade">
                                <Border MinWidth="{Binding ActualWidth, ElementName=Root}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Margin="0,5,0,0" Padding="4"
                                        Background="{DynamicResource PanelBrush}"
                                        BorderBrush="{DynamicResource StrokeBrush}"
                                        BorderThickness="1" CornerRadius="8">
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background"
                                        Value="{DynamicResource PanelHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Arrow" Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="180" CenterX="4" CenterY="2.5"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- CheckBox style is inherited from App.xaml (LumaCheckBox); do not redeclare here. -->
        <!-- TextBox/ContextMenu styles inherit from App.xaml. -->
    </Window.Resources>

    <Border x:Name="SettingsFrame" CornerRadius="14" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
            Background="Transparent" ClipToBounds="True">
        <Grid x:Name="SettingsRoot" SizeChanged="SettingsRoot_SizeChanged">
            <Grid.RowDefinitions>
                <RowDefinition Height="58"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="58"/>
            </Grid.RowDefinitions>

            <Border x:Name="SettingsRightBackdrop" Grid.Row="0" Grid.RowSpan="3" Margin="190,0,0,0"
                    Background="{DynamicResource PanelBrush}" CornerRadius="0,13,13,0"/>
            <Border x:Name="SidebarBackdrop" Grid.Row="0" Grid.RowSpan="3" Width="190" HorizontalAlignment="Left"
                    Background="{DynamicResource SettingsSidebarMaterialBrush}" CornerRadius="13,0,0,13"/>

            <Grid Grid.Row="0" Margin="20,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Luma 设置" FontSize="15" FontWeight="SemiBold"/>
                </StackPanel>
                <Button Content="&#xE8BB;" FontFamily="Segoe Fluent Icons" FontSize="13" Width="30" Height="30"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource QuietButton}"
                        Padding="0" Click="Cancel_Click"/>
            </Grid>

            <Grid Grid.Row="1" Margin="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SettingsSidebarColumn" Width="190"/>
                    <ColumnDefinition Width="0"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="Transparent">
                <ListBox x:Name="SettingsNav" Background="Transparent" BorderThickness="0"
                         Padding="11,10"
                         SelectedIndex="0" SelectionChanged="SettingsNav_SelectionChanged"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Padding" Value="10,7"/>
                            <Setter Property="Margin" Value="0,2"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="NavChrome" CornerRadius="8" Padding="{TemplateBinding Padding}"
                                                Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="NavChrome" Property="Background" Value="{DynamicResource PanelHoverBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="NavChrome" Property="Background" Value="{DynamicResource SpotlightSelectionBrush}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource SpotlightSelectionTextBrush}"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="NavChrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBoxItem Tag="General"><StackPanel Orientation="Horizontal"><Border Width="24" Height="24" CornerRadius="6" Background="#FF7C82EE"><TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons" Foreground="White" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="常规" Margin="11,0,0,0" VerticalAlignment="Center"/></StackPanel></ListBoxItem>
                    <ListBoxItem Tag="Appearance"><StackPanel Orientation="Horizontal"><Border Width="24" Height="24" CornerRadius="6" Background="#FF3BA9ED"><TextBlock Text="&#xE790;" FontFamily="Segoe Fluent Icons" Foreground="White" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="外观" Margin="11,0,0,0" VerticalAlignment="Center"/></StackPanel></ListBoxItem>
                    <ListBoxItem Tag="Search"><StackPanel Orientation="Horizontal"><Border Width="24" Height="24" CornerRadius="6" Background="#FFED9A3F"><TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons" Foreground="White" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="搜索" Margin="11,0,0,0" VerticalAlignment="Center"/></StackPanel></ListBoxItem>
                    <ListBoxItem Tag="Sources"><StackPanel Orientation="Horizontal"><Border Width="24" Height="24" CornerRadius="6" Background="#FF54AE65"><TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons" Foreground="White" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="数据源" Margin="11,0,0,0" VerticalAlignment="Center"/></StackPanel></ListBoxItem>
                    <ListBoxItem Tag="Features"><StackPanel Orientation="Horizontal"><Border Width="24" Height="24" CornerRadius="6" Background="#FFAA72DD"><TextBlock Text="&#xE8D4;" FontFamily="Segoe Fluent Icons" Foreground="White" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="能力" Margin="11,0,0,0" VerticalAlignment="Center"/></StackPanel></ListBoxItem>
                    <ListBoxItem Tag="Privacy"><StackPanel Orientation="Horizontal"><Border Width="24" Height="24" CornerRadius="6" Background="#FF767F89"><TextBlock Text="&#xE72E;" FontFamily="Segoe Fluent Icons" Foreground="White" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="隐私" Margin="11,0,0,0" VerticalAlignment="Center"/></StackPanel></ListBoxItem>
                    <ListBoxItem Tag="About"><StackPanel Orientation="Horizontal"><Border Width="24" Height="24" CornerRadius="6" Background="#FF5A9FE7"><TextBlock Text="&#xE946;" FontFamily="Segoe Fluent Icons" Foreground="White" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="关于" Margin="11,0,0,0" VerticalAlignment="Center"/></StackPanel></ListBoxItem>
                </ListBox>
                </Border>

                <Border Grid.Column="2" Background="{DynamicResource PanelBrush}" ClipToBounds="True">
                <ScrollViewer x:Name="SettingsScroll" VerticalScrollBarVisibility="Auto"
                              Background="Transparent"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="22,20,22,22">

                        <!-- 常规 -->
                        <StackPanel x:Name="SectionGeneral">
                            <TextBlock Text="常规" Style="{StaticResource SectionHeading}"/>
                            <TextBlock Text="键盘与显示" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" Margin="4,0,0,7"/>
                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <Grid MinHeight="45">
                                        <Grid.ColumnDefinitions><ColumnDefinition x:Name="HotkeyLabelColumn" Width="138"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="唤醒快捷键" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" x:Name="HotkeyBox" AutomationProperties.Name="全局快捷键"
                                                 IsReadOnly="True" Cursor="Hand" CaretBrush="{x:Null}"
                                                 PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                                                 GotKeyboardFocus="HotkeyBox_GotKeyboardFocus"
                                                 LostKeyboardFocus="HotkeyBox_LostKeyboardFocus"
                                                 ToolTip="点击后直接按下快捷键组合；Esc 取消"/>
                                    </Grid>
                                    <TextBlock x:Name="HotkeyCaptureHint" TextWrapping="Wrap" Text="点击后直接按下组合键，Esc 取消。"
                                               Foreground="{DynamicResource FaintTextBrush}" FontSize="11.5" Margin="138,0,0,8"/>
                                    <Border Height="1" Background="{DynamicResource StrokeBrush}"/>
                                    <Grid MinHeight="49">
                                        <Grid.ColumnDefinitions><ColumnDefinition x:Name="LanguageLabelColumn" Width="138"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="界面语言" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Column="1" x:Name="LanguageBox" SelectedValuePath="Tag" VerticalAlignment="Center">
                                            <ComboBoxItem Content="简体中文" Tag="zh-CN"/>
                                            <ComboBoxItem Content="English" Tag="en-US"/>
                                        </ComboBox>
                                    </Grid>
                                    <Border Height="1" Background="{DynamicResource StrokeBrush}"/>
                                    <Grid MinHeight="49">
                                        <Grid.ColumnDefinitions><ColumnDefinition x:Name="DensityLabelColumn" Width="138"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="列表密度" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Column="1" x:Name="DensityBox" SelectedValuePath="Tag" VerticalAlignment="Center">
                                            <ComboBoxItem Content="舒适" Tag="Comfortable"/>
                                            <ComboBoxItem Content="紧凑" Tag="Compact"/>
                                        </ComboBox>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="启动行为" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" Margin="4,22,0,7"/>
                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel>
                                    <Grid MinHeight="45">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="登录 Windows 后自动启动" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                        <CheckBox x:Name="StartupBox" Grid.Column="1" Content="" AutomationProperties.Name="登录 Windows 后自动启动"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Border Height="1" Background="{DynamicResource StrokeBrush}"/>
                                    <Grid MinHeight="45">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="记住主窗口位置" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                        <CheckBox x:Name="RememberPositionBox" Grid.Column="1" Content="" AutomationProperties.Name="记住主窗口位置"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- 外观 -->
                        <StackPanel x:Name="SectionAppearance" Visibility="Collapsed">
                            <TextBlock Text="外观" Style="{StaticResource SectionHeading}"/>
                            <Border Style="{StaticResource SectionCard}"><StackPanel>
                            <Grid MinHeight="49">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="主题" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1" AutomationProperties.Name="主题" x:Name="ThemeBox" SelectedValuePath="Tag"
                                          SelectionChanged="ThemeBox_SelectionChanged" VerticalAlignment="Center">
                                <ComboBoxItem Content="自动（随系统日夜）" Tag="Auto"/>
                                <ComboBoxItem Content="Apple · 深色" Tag="AppleDark"/>
                                <ComboBoxItem Content="Apple · 浅色" Tag="AppleLight"/>
                                <ComboBoxItem Content="墨青 · 夜" Tag="InkTeal"/>
                                <ComboBoxItem Content="赭暮 · 夜" Tag="Dusk"/>
                                <ComboBoxItem Content="素笺 · 日" Tag="Paper"/>
                                <ComboBoxItem Content="晴空 · 日" Tag="Sky"/>
                                </ComboBox>
                            </Grid>
                            <TextBlock x:Name="ThemeEffectiveHint" Foreground="{DynamicResource FaintTextBrush}" FontSize="11.5"
                                       Margin="120,0,0,10" TextWrapping="Wrap"/>

                            <Grid x:Name="AutoPairPanel" Margin="0,0,0,0">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Row="0" Grid.ColumnSpan="2" Height="1" Background="{DynamicResource StrokeBrush}"/>
                                <TextBlock Grid.Row="1" Text="日间主题" VerticalAlignment="Center"/>
                                <ComboBox Grid.Row="1" Grid.Column="1" x:Name="DayThemeBox" SelectedValuePath="Tag" AutomationProperties.Name="日间主题"
                                          Margin="0,7" SelectionChanged="DayThemeBox_SelectionChanged">
                                        <ComboBoxItem Content="Apple · 浅色" Tag="AppleLight"/>
                                        <ComboBoxItem Content="素笺" Tag="Paper"/>
                                        <ComboBoxItem Content="晴空" Tag="Sky"/>
                                </ComboBox>
                                <Border Grid.Row="2" Grid.ColumnSpan="2" Height="1" VerticalAlignment="Top" Background="{DynamicResource StrokeBrush}"/>
                                <TextBlock Grid.Row="2" Text="夜间主题" VerticalAlignment="Center" Margin="0,1,0,0"/>
                                <ComboBox Grid.Row="2" Grid.Column="1" x:Name="NightThemeBox" SelectedValuePath="Tag" AutomationProperties.Name="夜间主题"
                                          Margin="0,8,0,0" SelectionChanged="NightThemeBox_SelectionChanged">
                                        <ComboBoxItem Content="Apple · 深色" Tag="AppleDark"/>
                                        <ComboBoxItem Content="墨青" Tag="InkTeal"/>
                                        <ComboBoxItem Content="赭暮" Tag="Dusk"/>
                                </ComboBox>
                            </Grid>
                            </StackPanel></Border>
                        </StackPanel>

                        <!-- 搜索 -->
                        <StackPanel x:Name="SectionSearch" Visibility="Collapsed">
                            <TextBlock Text="搜索" Style="{StaticResource SectionHeading}"/>
                            <Border Style="{StaticResource SectionCard}"><StackPanel>
                            <TextBlock Text="结果排序" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,0,0,7"/>
                            <ComboBox x:Name="ResultSortBox" SelectedValuePath="Tag" AutomationProperties.Name="默认结果排序"/>
                            <TextBlock Text="与搜索界面排序按钮同步。空搜索仍显示最近使用。" TextWrapping="Wrap"
                                       Foreground="{DynamicResource FaintTextBrush}" FontSize="11.5" Margin="2,5,0,0"/>

                            <TextBlock Text="应用别名" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,16,0,7"/>
                            <TextBox AutomationProperties.Name="应用别名" x:Name="AliasesBox" Height="66" AcceptsReturn="True" VerticalContentAlignment="Top"
                                     VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                                     ToolTip="每行一个：vsc=Visual Studio Code"/>
                            <TextBlock Text="每行一个，例如：vsc=Visual Studio Code" Foreground="{DynamicResource FaintTextBrush}"
                                       FontSize="11.5" Margin="2,5,0,0"/>

                            <TextBlock Text="附加应用目录" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,16,0,7"/>
                            <TextBox AutomationProperties.Name="附加应用目录" x:Name="AppFoldersBox" Height="58" AcceptsReturn="True" VerticalContentAlignment="Top"
                                     VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap"/>
                            <TextBlock Text="每行一个目录；用于便携应用。" Foreground="{DynamicResource FaintTextBrush}"
                                       FontSize="11.5" Margin="2,5,0,0"/>

                            <TextBlock Text="自定义命令" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,16,0,7"/>
                            <TextBox AutomationProperties.Name="自定义命令" x:Name="CommandsBox" Height="88" AcceptsReturn="True" VerticalContentAlignment="Top"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"/>
                            <TextBlock Text="格式：关键词|标题|程序|参数|工作目录；参数中可使用 {query}。"
                                       Foreground="{DynamicResource FaintTextBrush}" FontSize="11.5" Margin="2,5,0,0" TextWrapping="Wrap"/>

                            <TextBlock Text="多引擎网页搜索" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,16,0,7"/>
                            <TextBox AutomationProperties.Name="搜索引擎" x:Name="EnginesBox" Height="88" AcceptsReturn="True" VerticalContentAlignment="Top"
                                     VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                                     ToolTip="g|Google|https://www.google.com/search?q={query}"/>
                            <TextBlock Text="格式：前缀|名称|URL；留空则使用内置引擎（g/bd/gh/bili 等）。"
                                       Foreground="{DynamicResource FaintTextBrush}" FontSize="11.5" Margin="2,5,0,0" TextWrapping="Wrap"/>
                            </StackPanel></Border>
                        </StackPanel>

                        <!-- 数据源 -->
                        <StackPanel x:Name="SectionSources" Visibility="Collapsed">
                            <TextBlock Text="数据源" Style="{StaticResource SectionHeading}"/>
                            <Border Style="{StaticResource SectionCard}"><StackPanel>
                            <Grid MinHeight="48">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Everything" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1" x:Name="EverythingModeBox" SelectedValuePath="Tag"
                                          SelectionChanged="EverythingMode_SelectionChanged" VerticalAlignment="Center">
                                <ComboBoxItem Content="自动查找（推荐）" Tag="Auto"/>
                                <ComboBoxItem Content="手动指定路径" Tag="Manual"/>
                                </ComboBox>
                            </Grid>

                            <Border Height="1" Background="{DynamicResource StrokeBrush}"/>
                            <Grid MinHeight="48">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="运行方式" VerticalAlignment="Center"/>
                                <ComboBox Grid.Column="1" x:Name="EverythingLifecycleBox" SelectedValuePath="Tag"
                                          SelectionChanged="EverythingMode_SelectionChanged" VerticalAlignment="Center">
                                <ComboBoxItem Content="由 Luma 管理（需要时自动启动）" Tag="Managed"/>
                                <ComboBoxItem Content="仅连接已有 Everything" Tag="Connect"/>
                                </ComboBox>
                            </Grid>

                            <Grid x:Name="EverythingPathGrid" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="EverythingPathBox" AutomationProperties.Name="Everything 程序路径"/>
                                <Button Grid.Column="1" Content="浏览" Style="{StaticResource QuietButton}" Margin="8,0,0,0"
                                        Padding="13,8" Click="BrowseEverything_Click"/>
                            </Grid>
                            <TextBlock x:Name="EverythingPathHint" Foreground="{DynamicResource FaintTextBrush}" FontSize="11.5"
                                       Margin="2,6,0,0" TextWrapping="Wrap"/>
                            <WrapPanel Margin="0,10,0,0">
                                <Button Content="重新检测" Click="DetectEverything_Click" Style="{StaticResource QuietButton}" Margin="0,0,8,0"/>
                                <Button Content="下载 Everything" Click="InstallEverything_Click" Style="{StaticResource QuietButton}"/>
                            </WrapPanel>
                            <TextBlock Text="托管模式使用独立配置副本，不修改已有配置。退出时只关闭由 Luma 启动的客户端。"
                                       TextWrapping="Wrap" Margin="2,8,0,0" Foreground="{DynamicResource MutedTextBrush}" FontSize="11.5"/>

                            <Border Height="1" Background="{DynamicResource StrokeBrush}" Margin="0,14,0,0"/>
                            <Grid MinHeight="48">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="优先使用 Windows 索引" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                <CheckBox x:Name="WindowsIndexBox" Grid.Column="1" Content="" AutomationProperties.Name="优先使用 Windows 索引"/>
                            </Grid>
                            <TextBlock Text="Luma 不安装索引服务；文件搜索优先 Everything，缺失时回退 Windows 搜索索引。"
                                       Foreground="{DynamicResource FaintTextBrush}" FontSize="11.5" Margin="2,11,0,0" TextWrapping="Wrap"/>
                            </StackPanel></Border>
                        </StackPanel>

                        <!-- 能力 -->
                        <StackPanel x:Name="SectionFeatures" Visibility="Collapsed">
                            <TextBlock Text="能力" Style="{StaticResource SectionHeading}"/>
                            <Border Style="{StaticResource SectionCard}"><StackPanel>
                            <Grid MinHeight="46"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="文件对话框快速切换（Ctrl+G）" TextWrapping="Wrap" VerticalAlignment="Center"/><CheckBox x:Name="QuickSwitchBox" Grid.Column="1" Content="" AutomationProperties.Name="文件对话框快速切换"/></Grid>
                            <Border Height="1" Background="{DynamicResource StrokeBrush}"/>
                            <Grid MinHeight="46"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="窗口切换" VerticalAlignment="Center"/><CheckBox x:Name="WindowSwitcherBox" Grid.Column="1" Content="" AutomationProperties.Name="窗口切换"/></Grid>
                            <Border Height="1" Background="{DynamicResource StrokeBrush}"/>
                            <Grid MinHeight="46"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="系统命令" VerticalAlignment="Center"/><CheckBox x:Name="SystemCommandsBox" Grid.Column="1" Content="" AutomationProperties.Name="系统命令"/></Grid>
                            <Border Height="1" Background="{DynamicResource StrokeBrush}"/>
                            <Grid MinHeight="46"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="浏览器书签搜索" VerticalAlignment="Center"/><CheckBox x:Name="BookmarksBox" Grid.Column="1" Content="" AutomationProperties.Name="浏览器书签搜索"/></Grid>
                            <Border Height="1" Background="{DynamicResource StrokeBrush}"/>
                            <Grid MinHeight="46"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="游戏模式 · 全屏时暂停热键" TextWrapping="Wrap" VerticalAlignment="Center"/><CheckBox x:Name="GameModeBox" Grid.Column="1" Content="" AutomationProperties.Name="游戏模式"/></Grid>
                            <Border Height="1" Background="{DynamicResource StrokeBrush}"/>
                            <Grid MinHeight="46"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="文件预览" VerticalAlignment="Center"/><CheckBox x:Name="PreviewBox" Grid.Column="1" Content="" AutomationProperties.Name="文件预览"/></Grid>
                            </StackPanel></Border>
                        </StackPanel>

                        <!-- 隐私 -->
                        <StackPanel x:Name="SectionPrivacy" Visibility="Collapsed">
                            <TextBlock Text="隐私" Style="{StaticResource SectionHeading}"/>
                            <Border Style="{StaticResource SectionCard}"><StackPanel>
                            <Grid MinHeight="46"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="记录使用历史" VerticalAlignment="Center"/><CheckBox x:Name="HistoryBox" Grid.Column="1" Content="" AutomationProperties.Name="记录使用历史"/></Grid>
                            <Border Height="1" Background="{DynamicResource StrokeBrush}"/>
                            <Grid MinHeight="46"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="记录搜索词历史" VerticalAlignment="Center"/><CheckBox x:Name="QueryHistoryBox" Grid.Column="1" Content="" AutomationProperties.Name="记录搜索词历史"/></Grid>
                            <Border Height="1" Background="{DynamicResource StrokeBrush}"/>
                            <Grid MinHeight="46"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="剪贴板历史（仅内存）" VerticalAlignment="Center"/><CheckBox x:Name="ClipboardBox" Grid.Column="1" Content="" AutomationProperties.Name="剪贴板历史"/></Grid>
                            <TextBlock Text="配置、收藏和使用历史保存在本机。暂停记录不会删除已有数据。"
                                       TextWrapping="Wrap" FontSize="11.5" Margin="0,10,0,12"
                                       Foreground="{DynamicResource MutedTextBrush}"/>
                            <WrapPanel>
                                <Button Content="清空历史（保留收藏）" Click="ClearHistory_Click" Style="{StaticResource QuietButton}" Margin="0,0,6,6"/>
                                <Button Content="清空搜索词历史" Click="ClearQueryHistory_Click" Style="{StaticResource QuietButton}" Margin="0,0,6,6"/>
                                <Button Content="导入配置" Click="ImportSettings_Click" Style="{StaticResource QuietButton}" Margin="0,0,6,6"/>
                                <Button Content="导出配置" Click="ExportSettings_Click" Style="{StaticResource QuietButton}" Margin="0,0,6,6"/>
                            </WrapPanel>
                            <TextBlock x:Name="PrivacyStatusText" TextWrapping="Wrap" FontSize="11.5"/>
                            </StackPanel></Border>
                        </StackPanel>

                        <!-- 关于 -->
                        <StackPanel x:Name="SectionAbout" Visibility="Collapsed">
                            <TextBlock Text="关于" Style="{StaticResource SectionHeading}"/>
                            <Border Style="{StaticResource SectionCard}"><StackPanel>
                            <TextBlock x:Name="VersionText" FontSize="12" Margin="0,0,0,12"/>
                            <WrapPanel>
                                <Button Content="检查更新" Click="CheckUpdate_Click" Style="{StaticResource QuietButton}" Margin="0,0,6,6"/>
                                <Button Content="下载并校验" Click="DownloadUpdate_Click" Style="{StaticResource QuietButton}" Margin="0,0,6,6"/>
                                <Button Content="下载页" Click="OpenRelease_Click" Style="{StaticResource QuietButton}" Margin="0,0,6,6"/>
                                <Button Content="开源许可" Click="Licenses_Click" Style="{StaticResource QuietButton}" Margin="0,0,6,6"/>
                            </WrapPanel>
                            <TextBlock x:Name="UpdateStatusText" Text="仅在点击检查时访问 GitHub。下载并校验会验证 SHA-256，不会静默覆盖。"
                                       TextWrapping="Wrap" FontSize="11.5" Margin="0,8,0,0"/>
                            </StackPanel></Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
                </Border>
            </Grid>

            <Grid Grid.Row="2" Margin="20,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="取消" Style="{StaticResource QuietButton}" Margin="0,0,9,0" Click="Cancel_Click"/>
                    <Button Content="保存" Style="{StaticResource AccentButton}" Click="Save_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
