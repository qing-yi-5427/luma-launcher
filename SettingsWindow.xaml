<Window x:Class="LumaLauncher.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Luma 设置" Icon="/Assets/Luma.ico" Width="470" Height="500" WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="NoResize" Topmost="True" Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI Variable Text, Segoe UI">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" CornerRadius="12" GlassFrameThickness="0" ResizeBorderThickness="0"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}"/>
        </Style>
    </Window.Resources>

    <Border CornerRadius="12" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
            Background="{DynamicResource WindowBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="66"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="66"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="22,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="LUMA / SETTINGS" FontFamily="Bahnschrift SemiCondensed, Segoe UI"
                               Foreground="{DynamicResource AccentBrush}" FontSize="10"/>
                    <TextBlock Text="偏好设置" FontSize="18" FontWeight="SemiBold" Margin="0,3,0,0"/>
                </StackPanel>
                <Button Content="&#xE8BB;" FontFamily="Segoe Fluent Icons" FontSize="13" Width="32" Height="32"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource QuietButton}"
                        Padding="0" Click="Cancel_Click"/>
            </Grid>

            <StackPanel Grid.Row="1" Margin="22,6">
                <TextBlock Text="唤醒快捷键" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,0,0,7"/>
                <ComboBox x:Name="HotkeyBox" SelectedValuePath="Tag">
                    <ComboBoxItem Content="Alt + Space" Tag="Alt+Space"/>
                    <ComboBoxItem Content="Ctrl + Space" Tag="Ctrl+Space"/>
                    <ComboBoxItem Content="Ctrl + Alt + Space" Tag="Ctrl+Alt+Space"/>
                    <ComboBoxItem Content="Ctrl + Shift + Space" Tag="Ctrl+Shift+Space"/>
                </ComboBox>

                <TextBlock Text="外观" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,19,0,7"/>
                <ComboBox x:Name="ThemeBox" SelectedValuePath="Tag">
                    <ComboBoxItem Content="跟随系统" Tag="System"/>
                    <ComboBoxItem Content="深色" Tag="Dark"/>
                    <ComboBoxItem Content="浅色" Tag="Light"/>
                </ComboBox>

                <TextBlock Text="Everything" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,19,0,7"/>
                <ComboBox x:Name="EverythingModeBox" SelectedValuePath="Tag"
                          SelectionChanged="EverythingMode_SelectionChanged">
                    <ComboBoxItem Content="自动查找（推荐）" Tag="Auto"/>
                    <ComboBoxItem Content="手动指定路径" Tag="Manual"/>
                </ComboBox>

                <Grid x:Name="EverythingPathGrid" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="EverythingPathBox" AutomationProperties.Name="Everything 程序路径"/>
                    <Button Grid.Column="1" Content="浏览" Style="{StaticResource QuietButton}" Margin="8,0,0,0"
                            Padding="13,8" Click="BrowseEverything_Click"/>
                </Grid>
                <TextBlock x:Name="EverythingPathHint" Foreground="{DynamicResource FaintTextBrush}" FontSize="10"
                           Margin="2,6,0,0" TextWrapping="Wrap" MaxHeight="28"/>

                <CheckBox x:Name="StartupBox" Content="登录 Windows 后自动启动" Margin="2,17,0,0"/>
                <TextBlock Text="Luma 不安装索引服务；文件搜索由本机 Everything 提供。"
                           Foreground="{DynamicResource FaintTextBrush}" FontSize="10" Margin="2,11,0,0"/>
            </StackPanel>

            <Grid Grid.Row="2" Margin="22,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="取消" Style="{StaticResource QuietButton}" Margin="0,0,9,0" Click="Cancel_Click"/>
                    <Button Content="保存" Style="{StaticResource QuietButton}" Background="{DynamicResource AccentSoftBrush}"
                            BorderBrush="{DynamicResource AccentBrush}" Click="Save_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
