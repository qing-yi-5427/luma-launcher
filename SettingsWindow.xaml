<Window x:Class="LumaLauncher.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Luma 设置" Icon="/Luma;component/Assets/Luma.ico" Width="540" Height="700" WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="NoResize" Topmost="True" Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI Variable Text, Microsoft YaHei UI, Segoe UI"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" CornerRadius="12" GlassFrameThickness="0" ResizeBorderThickness="0"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="LumaComboBoxItemStyle" TargetType="{x:Type ComboBoxItem}">
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                        <Border x:Name="ItemBackground" Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBackground" Property="Background"
                                        Value="{DynamicResource PanelHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBackground" Property="Background"
                                        Value="{DynamicResource PanelSelectedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusStyle}"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource LumaComboBoxItemStyle}"/>
            <Setter Property="MaxDropDownHeight" Value="260"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid x:Name="Root">
                            <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7"/>

                            <ContentPresenter Margin="10,0,38,0" VerticalAlignment="Center"
                                              HorizontalAlignment="Left" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              RecognizesAccessKey="True"/>

                            <Path x:Name="Arrow" Width="8" Height="5" Margin="0,0,13,0"
                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Data="M 0 0 L 4 4 L 8 0" Stroke="{DynamicResource MutedTextBrush}"
                                  StrokeThickness="1.4" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  IsHitTestVisible="False"/>

                            <ToggleButton Focusable="False" ClickMode="Press" Background="Transparent"
                                          BorderThickness="0"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   PopupAnimation="Fade">
                                <Border MinWidth="{Binding ActualWidth, ElementName=Root}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Margin="0,5,0,0" Padding="4"
                                        Background="{DynamicResource PanelBrush}"
                                        BorderBrush="{DynamicResource StrokeBrush}"
                                        BorderThickness="1" CornerRadius="8">
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background"
                                        Value="{DynamicResource PanelHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Arrow" Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="180" CenterX="4" CenterY="2.5"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}"/>
        </Style>
    </Window.Resources>

    <Border CornerRadius="12" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
            Background="{DynamicResource WindowBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="66"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="66"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="22,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="LUMA / SETTINGS" FontFamily="Bahnschrift SemiCondensed, Segoe UI"
                               Foreground="{DynamicResource AccentBrush}" FontSize="11.5"/>
                    <TextBlock Text="偏好设置" FontSize="18" FontWeight="SemiBold" Margin="0,3,0,0"/>
                </StackPanel>
                <Button Content="&#xE8BB;" FontFamily="Segoe Fluent Icons" FontSize="13" Width="32" Height="32"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource QuietButton}"
                        Padding="0" Click="Cancel_Click"/>
            </Grid>

            <ScrollViewer Grid.Row="1" Margin="22,6" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,8,10">
                <TextBlock Text="唤醒快捷键" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,0,0,7"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="HotkeyBox" AutomationProperties.Name="全局快捷键"
                             ToolTip="任意组合，例如 Alt+E、Ctrl+Shift+F12、Win+Space"/>
                    <ComboBox Grid.Column="1" x:Name="HotkeyPresetBox" Width="120" Margin="8,0,0,0"
                              AutomationProperties.Name="快捷键预设" SelectionChanged="HotkeyPreset_SelectionChanged">
                        <ComboBoxItem Content="预设…" Tag=""/>
                        <ComboBoxItem Content="Alt + Space" Tag="Alt+Space"/>
                        <ComboBoxItem Content="Ctrl + Space" Tag="Ctrl+Space"/>
                        <ComboBoxItem Content="Ctrl + Alt + Space" Tag="Ctrl+Alt+Space"/>
                        <ComboBoxItem Content="Ctrl + Shift + Space" Tag="Ctrl+Shift+Space"/>
                        <ComboBoxItem Content="Alt + E" Tag="Alt+E"/>
                        <ComboBoxItem Content="Ctrl + Shift + F12" Tag="Ctrl+Shift+F12"/>
                    </ComboBox>
                </Grid>
                <TextBlock Text="支持 Alt/Ctrl/Shift/Win + 字母、数字、F 键、Space 等。"
                           Foreground="{DynamicResource FaintTextBrush}" FontSize="11.5" Margin="2,5,0,0"/>

                <TextBlock Text="界面语言" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,16,0,7"/>
                <ComboBox x:Name="LanguageBox" SelectedValuePath="Tag">
                    <ComboBoxItem Content="简体中文" Tag="zh-CN"/>
                    <ComboBoxItem Content="English" Tag="en-US"/>
                </ComboBox>

                <TextBlock Text="外观" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,19,0,7"/>
                <ComboBox AutomationProperties.Name="主题" x:Name="ThemeBox" SelectedValuePath="Tag" SelectionChanged="ThemeBox_SelectionChanged">
                    <ComboBoxItem Content="跟随系统" Tag="System"/>
                    <ComboBoxItem Content="Luma 暖夜" Tag="Dark"/>
                    <ComboBoxItem Content="Luma 暖昼" Tag="Light"/>
                    <ComboBoxItem Content="Windows 11 · 蓝晶" Tag="Win11Blue"/>
                    <ComboBoxItem Content="Windows 11 · 石墨" Tag="Win11Graphite"/>
                    <ComboBoxItem Content="Windows 11 · 雾白" Tag="Win11Mist"/>
                    <ComboBoxItem Content="Windows 11 · 鼠尾草" Tag="Win11Sage"/>
                </ComboBox>

                <TextBlock Text="Everything" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,19,0,7"/>
                <ComboBox x:Name="EverythingModeBox" SelectedValuePath="Tag"
                          SelectionChanged="EverythingMode_SelectionChanged">
                    <ComboBoxItem Content="自动查找（推荐）" Tag="Auto"/>
                    <ComboBoxItem Content="手动指定路径" Tag="Manual"/>
                </ComboBox>

                <TextBlock Text="运行方式" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,12,0,7"/>
                <ComboBox x:Name="EverythingLifecycleBox" SelectedValuePath="Tag"
                          SelectionChanged="EverythingMode_SelectionChanged">
                    <ComboBoxItem Content="由 Luma 管理（需要时自动启动）" Tag="Managed"/>
                    <ComboBoxItem Content="仅连接已有 Everything" Tag="Connect"/>
                </ComboBox>

                <Grid x:Name="EverythingPathGrid" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="EverythingPathBox" AutomationProperties.Name="Everything 程序路径"/>
                    <Button Grid.Column="1" Content="浏览" Style="{StaticResource QuietButton}" Margin="8,0,0,0"
                            Padding="13,8" Click="BrowseEverything_Click"/>
                </Grid>
                <TextBlock x:Name="EverythingPathHint" Foreground="{DynamicResource FaintTextBrush}" FontSize="11.5"
                           Margin="2,6,0,0" TextWrapping="Wrap"/>
                <WrapPanel Margin="0,10,0,0">
                    <Button Content="重新检测" Click="DetectEverything_Click" Style="{StaticResource QuietButton}" Margin="0,0,8,0"/>
                    <Button Content="下载 Everything" Click="InstallEverything_Click" Style="{StaticResource QuietButton}"/>
                </WrapPanel>
                <TextBlock Text="托管模式使用独立配置副本，不修改已有配置。退出时关闭由 Luma 启动的后台客户端；您预先运行的 Everything 和索引服务不受影响。"
                           TextWrapping="Wrap" Margin="2,8,0,0" Foreground="{DynamicResource MutedTextBrush}" FontSize="11.5"/>

                <CheckBox x:Name="StartupBox" Content="登录 Windows 后自动启动" Margin="2,17,0,0"/>
                <CheckBox x:Name="QuickSwitchBox" Content="启用文件对话框快速切换（Ctrl + G）" Margin="2,12,0,0"/>
                <CheckBox x:Name="WindowSwitcherBox" Content="启用窗口切换（搜窗口标题 / 进程名）" Margin="2,12,0,0"/>
                <CheckBox x:Name="SystemCommandsBox" Content="启用系统命令（锁屏、关机、设置等）" Margin="2,12,0,0"/>
                <CheckBox x:Name="BookmarksBox" Content="启用浏览器书签搜索" Margin="2,12,0,0"/>
                <CheckBox x:Name="GameModeBox" Content="游戏模式：全屏应用时暂停热键（Ctrl+F12 手动切换）" Margin="2,12,0,0"/>
                <CheckBox x:Name="PreviewBox" Content="启用文件预览（空格 / 选中时）" Margin="2,12,0,0"/>
                <CheckBox x:Name="WindowsIndexBox" Content="优先使用 Windows 索引（Everything 不可用时自动回退）" Margin="2,12,0,0"/>
                <TextBlock Text="Luma 不安装索引服务；文件搜索优先使用 Everything，缺失时回退 Windows 搜索索引。"
                           Foreground="{DynamicResource FaintTextBrush}" FontSize="11.5" Margin="2,11,0,0"/>

                <TextBlock Text="搜索个性化" Foreground="{DynamicResource AccentBrush}" FontSize="11.5"
                           FontFamily="Bahnschrift SemiCondensed, Segoe UI" Margin="0,23,0,10"/>
                <TextBlock Text="结果排序" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,0,0,7"/>
                <ComboBox x:Name="ResultSortBox" SelectedValuePath="Tag" AutomationProperties.Name="默认结果排序"/>
                <TextBlock Text="与搜索界面排序按钮同步。名称/大小/修改时间在 Everything 全匹配中排序，应用和工具随后；大小排序中文件夹无大小，按名称排在文件后。智能/相关性/常用仅排序已召回候选；空搜索仍显示最近使用。" TextWrapping="Wrap"
                           Foreground="{DynamicResource FaintTextBrush}" FontSize="11.5" Margin="2,5,0,0"/>

                <TextBlock Text="应用别名" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,16,0,7"/>
                <TextBox AutomationProperties.Name="应用别名" x:Name="AliasesBox" Height="66" AcceptsReturn="True" VerticalContentAlignment="Top"
                         VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                         ToolTip="每行一个：vsc=Visual Studio Code"/>
                <TextBlock Text="每行一个，例如：vsc=Visual Studio Code" Foreground="{DynamicResource FaintTextBrush}"
                           FontSize="11.5" Margin="2,5,0,0"/>

                <TextBlock Text="附加应用目录" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,16,0,7"/>
                <TextBox AutomationProperties.Name="附加应用目录" x:Name="AppFoldersBox" Height="58" AcceptsReturn="True" VerticalContentAlignment="Top"
                         VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap"/>
                <TextBlock Text="每行一个目录；用于便携应用。" Foreground="{DynamicResource FaintTextBrush}"
                           FontSize="11.5" Margin="2,5,0,0"/>

                <TextBlock Text="自定义命令" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,16,0,7"/>
                <TextBox AutomationProperties.Name="自定义命令" x:Name="CommandsBox" Height="88" AcceptsReturn="True" VerticalContentAlignment="Top"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"/>
                <TextBlock Text="格式：关键词|标题|程序|参数|工作目录；参数中可使用 {query}。"
                           Foreground="{DynamicResource FaintTextBrush}" FontSize="11.5" Margin="2,5,0,0" TextWrapping="Wrap"/>

                <TextBlock Text="多引擎网页搜索" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,16,0,7"/>
                <TextBox AutomationProperties.Name="搜索引擎" x:Name="EnginesBox" Height="88" AcceptsReturn="True" VerticalContentAlignment="Top"
                         VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                         ToolTip="g|Google|https://www.google.com/search?q={query}"/>
                <TextBlock Text="格式：前缀|名称|URL；留空则使用内置引擎（g/bd/gh/bili 等）。"
                           Foreground="{DynamicResource FaintTextBrush}" FontSize="11.5" Margin="2,5,0,0" TextWrapping="Wrap"/>

                <TextBlock Text="数据与隐私" FontSize="14" FontWeight="SemiBold" Margin="0,24,0,10"/>
                <CheckBox x:Name="HistoryBox" Content="记录使用历史，用于推荐和排序"/>
                <CheckBox x:Name="QueryHistoryBox" Content="记录搜索词历史（Ctrl+H 面板与 Tab 补全）" Margin="0,12,0,0"/>
                <TextBlock Text="配置、收藏和使用历史保存在本机。暂停记录不会删除已有数据。"
                           TextWrapping="Wrap" FontSize="11.5" Margin="0,8,0,10"/>
                <WrapPanel>
                    <Button Content="清空历史（保留收藏）" Click="ClearHistory_Click" Style="{StaticResource QuietButton}" Margin="0,0,6,6"/>
                    <Button Content="清空搜索词历史" Click="ClearQueryHistory_Click" Style="{StaticResource QuietButton}" Margin="0,0,6,6"/>
                    <Button Content="导入配置" Click="ImportSettings_Click" Style="{StaticResource QuietButton}" Margin="0,0,6,6"/>
                    <Button Content="导出配置" Click="ExportSettings_Click" Style="{StaticResource QuietButton}" Margin="0,0,6,6"/>
                </WrapPanel>
                <TextBlock x:Name="PrivacyStatusText" TextWrapping="Wrap" FontSize="11.5"/>
                <TextBlock Text="关于与更新" FontSize="14" FontWeight="SemiBold" Margin="0,24,0,10"/>
                <TextBlock x:Name="VersionText" FontSize="12" Margin="0,0,0,10"/>
                <WrapPanel>
                    <Button Content="检查更新" Click="CheckUpdate_Click" Style="{StaticResource QuietButton}" Margin="0,0,6,6"/>
                    <Button Content="下载并校验" Click="DownloadUpdate_Click" Style="{StaticResource QuietButton}" Margin="0,0,6,6"/>
                    <Button Content="下载页" Click="OpenRelease_Click" Style="{StaticResource QuietButton}" Margin="0,0,6,6"/>
                    <Button Content="开源许可" Click="Licenses_Click" Style="{StaticResource QuietButton}" Margin="0,0,6,6"/>
                </WrapPanel>
                <TextBlock x:Name="UpdateStatusText" Text="仅在点击检查时访问 GitHub。下载并校验会验证 SHA-256 后暂存替换脚本，不会静默覆盖。"
                           TextWrapping="Wrap" FontSize="11.5"/>
            </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2" Margin="22,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="取消" Style="{StaticResource QuietButton}" Margin="0,0,9,0" Click="Cancel_Click"/>
                    <Button Content="保存" Style="{StaticResource QuietButton}" Background="{DynamicResource AccentSoftBrush}"
                            BorderBrush="{DynamicResource AccentBrush}" Click="Save_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
