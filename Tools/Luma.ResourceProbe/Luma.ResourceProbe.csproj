<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <LumaAssemblyPath Condition="'$(LumaAssemblyPath)' == ''">$(MSBuildThisFileDirectory)..\..\bin\Release\net10.0-windows\Luma.dll</LumaAssemblyPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Luma"><HintPath>$(LumaAssemblyPath)</HintPath></Reference>
    <None Include="..\..\dll\Everything64.dll" Link="Everything64.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
